<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title><%= pageTitle %> - Mentor</title>

    <link href="/assets/img/favicon.png" rel="icon" />
    <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans&family=Poppins&family=Raleway&display=swap"
      rel="stylesheet"
    />
    <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="/assets/vendor/aos/aos.css" rel="stylesheet" />
    <link href="/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />
    <link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />
    <link href="/assets/css/main.css" rel="stylesheet" />
  </head>

  <body class="<%= pageClass %>">
    <header id="header" class="header d-flex align-items-center sticky-top">
      <div class="container-fluid container-xl position-relative d-flex align-items-center">
        <a href="/" class="logo d-flex align-items-center me-auto">
          <h1 class="sitename">Mentor</h1>
        </a>

        <nav id="navmenu" class="navmenu">
          <ul>
            <li><a href="/" class="<%= pageTitle === 'Home' ? 'active' : '' %>">Home</a></li>
            <li><a href="/about" class="<%= pageTitle === 'About' ? 'active' : '' %>">About</a></li>
            <li><a href="/courses" class="<%= pageTitle === 'Courses' ? 'active' : '' %>">Courses</a></li>
            <li><a href="/trainers" class="<%= pageTitle === 'Trainers' ? 'active' : '' %>">Trainers</a></li>
            <li><a href="/events" class="<%= pageTitle === 'Events' ? 'active' : '' %>">Events</a></li>
            <li><a href="/contacts/new" class="<%= pageTitle === 'Contact Us' ? 'active' : '' %>">Contact</a></li>

            <% if (isAuthenticated) { %>
              <% if (currentUser && currentUser.roles.includes('admin')) { %>
                <li class="dropdown">
                  <a href="#"><span>Admin</span> <i class="bi bi-chevron-down dropdown-indicator"></i></a>
                  <ul>
                    <li><a href="/courses/admin/create">Create Course</a></li>
                    <li><a href="/contacts/admin/list">Respond to Contacts</a></li>
                    <li><a href="/externalapi">Lacrosse API View</a></li>
                  </ul>
                </li>
              <% } %>
              <li>
                <form action="/auth/logout" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-link nav-link" style="padding: 0; color: inherit; text-decoration: none;">Logout</button>
                </form>
              </li>
            <% } else { %>
              <li><a href="/auth/login">Login/Signup</a></li>
            <% } %>
          </ul>
          <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>
      </div>
    </header>

    <% if (successMessage && successMessage.length > 0) { %>
      <div class="container mt-3">
        <div class="alert alert-success text-center"><%= successMessage[0] %></div>
      </div>
    <% } %>

    <% if (errorMessage && errorMessage.length) { %>
      <div class="container mt-3">
        <div class="alert alert-danger text-center"><%= errorMessage[0] %></div>
      </div>
    <% } %>

    <main class="main"><%- body %></main>

    <footer id="footer" class="footer position-relative light-background">
      <div class="container footer-top">
        <div class="row gy-4">
          <div class="col-lg-4 col-md-6 footer-about">
            <a href="/" class="logo d-flex align-items-center">
              <span class="sitename">Mentor</span>
            </a>
            <div class="footer-contact pt-3">
              <p>976-1004 E 550 N</p>
              <p>Logan, UT 84321</p>
              <p><strong>Phone:</strong> +1 435 797 2272</p>
              <p><strong>Email:</strong> info@mentor.com</p>
            </div>
            <div class="social-links d-flex mt-4">
              <a href="#"><i class="bi bi-twitter-x"></i></a>
              <a href="#"><i class="bi bi-facebook"></i></a>
              <a href="#"><i class="bi bi-instagram"></i></a>
              <a href="#"><i class="bi bi-linkedin"></i></a>
            </div>
          </div>

          <div class="col-lg-2 col-md-3 footer-links">
            <h4>Useful Links</h4>
            <ul>
              <li><a href="#">Home</a></li>
              <li><a href="#">About us</a></li>
              <li><a href="#">Services</a></li>
              <li><a href="#">Terms of service</a></li>
              <li><a href="#">Privacy policy</a></li>
            </ul>
          </div>

          <div class="col-lg-2 col-md-3 footer-links">
            <h4>Our Services</h4>
            <ul>
              <li><a href="#">Web Design</a></li>
              <li><a href="#">Web Development</a></li>
              <li><a href="#">Product Management</a></li>
              <li><a href="#">Marketing</a></li>
              <li><a href="#">Graphic Design</a></li>
            </ul>
          </div>

          <div class="col-lg-4 col-md-12 footer-newsletter">
            <h4>Our Newsletter</h4>
            <p>Subscribe to our newsletter for the latest updates!</p>
            <form action="#" method="post" class="php-email-form">
              <div class="newsletter-form">
                <input type="email" name="email" />
                <input type="submit" value="Subscribe" />
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="container text-center mt-4">
        <p>© <strong class="sitename">Mentor</strong> All Rights Reserved</p>
        <div class="credits">
          Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a>
        </div>
      </div>
    </footer>

    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center">
      <i class="bi bi-arrow-up-short"></i>
    </a>

    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/php-email-form/validate.js"></script>
    <script src="/assets/vendor/aos/aos.js"></script>
    <script src="/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>
